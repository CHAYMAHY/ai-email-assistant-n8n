{
  "name": "AI-Powered Email Assistant",
  "nodes": [
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4o-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "=You are a helpful email assistant. Your job is to read incoming emails, summarize them in one line, and decide whether they need a reply. If a reply is needed, you will draft a polite response based on the email content. Always draft the response in HTML format so that it is ready to be sent."
            },
            {
              "content": "=Your Tasks:\n1. Summarize the email given below in one line.\n2. Tell me if a reply is needed (Yes/No).\n3. If yes, suggest a short and polite reply I can send.\n\nPlease respond in the following JSON format:\n\n{\n  \"summary\": \"One sentence summary of the email\",\n  \"reply_needed\": \"Yes or No\",\n  \"suggested_reply\": \"Only if reply_needed is Yes, else leave as empty string\"\n}\n\nHere is the email body received:\n\n************\n\n{{ $json.text }}\n\n************"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_object"
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        224,
        80
      ],
      "id": "f75a31ea-700b-4bd7-851e-9874fa03eaea",
      "name": "summarize emails & draft replies"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "9743fd34-b8e6-4358-9a73-a3344a25f04a",
              "leftValue": "={{ $json.output[0].content[0].text.reply_needed }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {
          "ignoreCase": true
        }
      },
      "type": "n8n-nodes-base.if",
